# SalonFlow Environment Configuration Template

# Application
APP_NAME=SalonFlow
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=salonflow-super-secret-production-grade-jwt-key-minimum-32-chars-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Falls back to sqlite:///./salonflow.db if PostgreSQL is not available locally
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salonflow
SQLITE_FALLBACK_URL=sqlite:///./salonflow.db

# Salon Operations Defaults
SALON_NAME="SalonFlow Luxury Studio"
SALON_TAGLINE="Smart Salon. Zero Waiting."
SALON_OPENING_TIME="09:00:00"
SALON_CLOSING_TIME="21:00:00"
ONLINE_QUEUE_CUTOFF_MINUTES=30
MAX_ONLINE_QUEUE_CAPACITY=30
